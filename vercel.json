{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },

    {
      "src": "/login",
      "dest": "/public/login.html"
    },

    {
      "src": "/dashboard",
      "dest": "/public/dashboard.html"
    },

    {
      "src": "/(.*)",
      "dest": "/public/$1"
    },

    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ]
}
